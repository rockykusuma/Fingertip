# Copy to .env.local (git-ignored) and fill in. Read by release.sh.

# Your "Developer ID Application" certificate, exactly as
#   security find-identity -v -p codesigning
# prints it.
DEV_ID="Developer ID Application: Your Name (TEAMID)"

# A notarytool keychain profile, made once with
#   xcrun notarytool store-credentials <name> --apple-id <id> --team-id <TEAMID> --password <app-specific password>
# The password lives in your keychain, never in this file.
NOTARY_PROFILE="your-notary-profile"
